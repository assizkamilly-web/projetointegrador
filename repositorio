<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sensores de Luz e Radiação Solar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --lavender: #d9eaff;
    --lilac: #eadfff;
    --rose: #ffe2ec;
    --mint: #e4f5eb;
    --cream: #fff8f0;
    --primary: #555477;
    --secondary: #8d79b5;
    --accent: #b17eaa;
    --soft-purple: #c9b8eb;
    --deep-purple: #8067aa;
    --text: #45445a;
    --muted: #68677e;
    --border: #e4dced;
    --bg: #faf7ff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px;
}

body {
    font-family: 'Poppins', 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.75;
    font-weight: 400;
    overflow-x: hidden;
    background-image: 
        radial-gradient(circle at 10% 20%, rgba(217, 234, 255, 0.4) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(255, 226, 236, 0.3) 0%, transparent 40%),
        radial-gradient(circle at 50% 50%, rgba(234, 223, 255, 0.3) 0%, transparent 50%);
}

/* ===== HEADER ===== */
header {
    position: relative;
    background: linear-gradient(135deg, #d9eaff 0%, #eadfff 50%, #ffe2ec 100%);
    text-align: center;
    padding: 90px 20px 110px;
    overflow: hidden;
}

header::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -10%;
    width: 60%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.5) 0%, transparent 60%);
    animation: float 15s ease-in-out infinite;
}

header::after {
    content: '';
    position: absolute;
    bottom: -10%;
    right: -10%;
    width: 50%;
    height: 150%;
    background: radial-gradient(circle, rgba(255,255,255,0.4) 0%, transparent 60%);
    animation: float 18s ease-in-out infinite reverse;
}

@keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(30px, -30px) rotate(5deg); }
}

header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 5vw, 48px);
    color: var(--primary);
    margin-bottom: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
    position: relative;
    z-index: 1;
    animation: fadeDown 1s ease;
}

header h1 .emoji {
    display: inline-block;
    animation: pulse 3s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15) rotate(10deg); }
}

header p {
    font-size: 18px;
    color: var(--muted);
    font-weight: 300;
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    animation: fadeUp 1s ease 0.3s both;
}

@keyframes fadeDown {
    from { opacity: 0; transform: translateY(-30px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

.header-decoration {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 60px;
    background: var(--bg);
    clip-path: polygon(0 100%, 100% 100%, 100% 0, 50% 100%, 0 0);
    opacity: 0.6;
}

/* ===== NAVIGATION ===== */
nav {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 18px 20px;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(220, 213, 245, 0.5);
    box-shadow: 0 2px 20px rgba(141, 121, 181, 0.08);
}

nav a {
    color: var(--primary);
    text-decoration: none;
    margin: 6px 12px;
    font-weight: 500;
    font-size: 15px;
    padding: 8px 16px;
    border-radius: 25px;
    display: inline-block;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
}

nav a::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--secondary), var(--accent));
    transition: all 0.3s ease;
    transform: translateX(-50%);
}

nav a:hover {
    color: var(--accent);
    background: rgba(234, 223, 255, 0.4);
    transform: translateY(-2px);
}

nav a:hover::before {
    width: 60%;
}

/* ===== CONTAINER ===== */
.container {
    max-width: 1100px;
    margin: auto;
    padding: 50px 20px;
}

/* ===== SECTIONS ===== */
section {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    padding: 45px;
    margin: 35px 0;
    border-radius: 24px;
    box-shadow: 
        0 10px 40px rgba(141, 121, 181, 0.08),
        0 2px 10px rgba(141, 121, 181, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.8);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    position: relative;
    overflow: hidden;
}

section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--lavender), var(--lilac), var(--rose));
    opacity: 0;
    transition: opacity 0.4s ease;
}

section:hover {
    transform: translateY(-4px);
    box-shadow: 
        0 20px 50px rgba(141, 121, 181, 0.12),
        0 5px 15px rgba(141, 121, 181, 0.06);
}

section:hover::before {
    opacity: 1;
}

h2 {
    font-family: 'Playfair Display', serif;
    color: var(--secondary);
    margin-bottom: 20px;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.5px;
    position: relative;
    padding-bottom: 15px;
}

h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, var(--secondary), var(--accent));
    border-radius: 3px;
}

h3 {
    color: var(--accent);
    margin: 20px 0 10px;
    font-size: 20px;
    font-weight: 600;
}

p {
    margin-bottom: 15px;
    color: var(--text);
    font-size: 16px;
}

/* ===== CARDS ===== */
.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 25px;
}

.card {
    padding: 28px;
    border-radius: 20px;
    background: linear-gradient(135deg, #e9f2ff 0%, #f0f5ff 100%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.5s ease;
}

.card:nth-child(2) {
    background: linear-gradient(135deg, #f5e9ff 0%, #f9f0ff 100%);
}

.card:nth-child(3) {
    background: linear-gradient(135deg, #e4f5eb 0%, #edf9f1 100%);
}

.card:nth-child(4) {
    background: linear-gradient(135deg, #fff0f5 0%, #fff5f8 100%);
}

.card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 15px 35px rgba(141, 121, 181, 0.15);
}

.card:hover::after {
    opacity: 1;
}

.card h3 {
    margin-top: 0;
    font-size: 22px;
}

.icon {
    font-size: 42px;
    margin-bottom: 15px;
    display: inline-block;
    filter: drop-shadow(0 4px 8px rgba(141, 121, 181, 0.2));
    transition: transform 0.4s ease;
}

.card:hover .icon {
    transform: scale(1.15) rotate(-5deg);
}

/* ===== HIGHLIGHT BOX ===== */
.highlight {
    background: linear-gradient(135deg, #fff0f5 0%, #fff8fa 100%);
    padding: 22px 26px;
    border-left: 5px solid var(--accent);
    border-radius: 14px;
    margin-top: 20px;
    position: relative;
    box-shadow: 0 4px 15px rgba(230, 169, 197, 0.15);
}

.highlight::before {
    content: '💡';
    position: absolute;
    top: -15px;
    left: 20px;
    background: var(--bg);
    padding: 0 8px;
    font-size: 20px;
}

.highlight strong {
    color: var(--accent);
    font-weight: 600;
    display: block;
    margin-bottom: 6px;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ===== SIMULATOR ===== */
.simulator {
    background: linear-gradient(135deg, #edf3ff 0%, #f5f0ff 100%);
    padding: 35px;
    border-radius: 20px;
    margin-top: 25px;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 2px 10px rgba(141, 121, 181, 0.05);
}

.simulator label {
    font-weight: 500;
    color: var(--primary);
    font-size: 16px;
    display: block;
    margin-bottom: 10px;
}

input[type="range"] {
    width: 90%;
    max-width: 500px;
    margin: 20px auto;
    accent-color: var(--secondary);
    height: 8px;
    -webkit-appearance: none;
    appearance: none;
    background: linear-gradient(90deg, var(--lavender), var(--lilac), var(--rose));
    border-radius: 10px;
    outline: none;
    cursor: pointer;
}

input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    background: white;
    border: 3px solid var(--secondary);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(141, 121, 181, 0.3);
    transition: transform 0.2s ease;
}

input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.2);
}

input[type="range"]::-moz-range-thumb {
    width: 24px;
    height: 24px;
    background: white;
    border: 3px solid var(--secondary);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(141, 121, 181, 0.3);
}

.resultado {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    color: var(--deep-purple);
    font-weight: 700;
    margin: 20px 0;
    letter-spacing: -1px;
    text-shadow: 0 2px 10px rgba(128, 103, 170, 0.15);
}

.bar {
    height: 26px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.7);
    margin: 20px auto;
    overflow: hidden;
    max-width: 500px;
    box-shadow: inset 0 2px 5px rgba(141, 121, 181, 0.1);
}

.fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #a8d8c0 0%, #a8b9ec 50%, #e6a9c5 100%);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 20px;
    position: relative;
    overflow: hidden;
}

.fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    animation: shimmer 2s infinite;
}

@keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

#situacao {
    font-size: 22px;
    margin: 15px 0 8px;
    color: var(--primary);
}

#descricao {
    color: var(--muted);
    font-style: italic;
    max-width: 500px;
    margin: 0 auto;
}

/* ===== BUTTONS ===== */
button {
    background: linear-gradient(135deg, var(--soft-purple), #b5a0dc);
    border: none;
    padding: 13px 28px;
    border-radius: 30px;
    color: white;
    font-weight: 600;
    cursor: pointer;
    margin: 8px;
    font-size: 15px;
    letter-spacing: 0.3px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(201, 184, 235, 0.4);
}

button:hover {
    background: linear-gradient(135deg, #b5a0dc, #a08bc8);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 184, 235, 0.5);
}

button:active {
    transform: translateY(0);
}

/* ===== TABLE ===== */
.table-wrapper {
    overflow-x: auto;
    margin-top: 20px;
    border-radius: 16px;
    box-shadow: 0 4px 15px rgba(141, 121, 181, 0.08);
}

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: white;
    border-radius: 16px;
    overflow: hidden;
}

td, th {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

th {
    background: linear-gradient(135deg, #e9e2f8 0%, #f0e9fa 100%);
    color: var(--primary);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

tr:last-child td {
    border-bottom: none;
}

tr:hover td {
    background: rgba(234, 223, 255, 0.2);
}

/* ===== FOOTER ===== */
footer {
    background: linear-gradient(135deg, #e5dcf5 0%, #f0e9fa 100%);
    text-align: center;
    padding: 50px 20px;
    margin-top: 60px;
    color: var(--primary);
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.5);
}

footer::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 60px;
    background: var(--bg);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 0, 0 100%);
}

footer h3 {
    font-family: 'Playfair Display', serif;
    color: var(--primary);
    font-size: 22px;
    margin-bottom: 10px;
}

footer p {
    color: var(--muted);
    font-size: 14px;
    margin: 5px 0;
}

.footer-decoration {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin: 20px 0;
    font-size: 24px;
}

.footer-decoration span {
    display: inline-block;
    animation: float-icon 3s ease-in-out infinite;
}

.footer-decoration span:nth-child(2) { animation-delay: 0.3s; }
.footer-decoration span:nth-child(3) { animation-delay: 0.6s; }
.footer-decoration span:nth-child(4) { animation-delay: 0.9s; }

@keyframes float-icon {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
}

/* ===== SCROLL REVEAL ===== */
.reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* ===== RESPONSIVE ===== */
@media(max-width: 768px) {
    header {
        padding: 60px 20px 80px;
    }
    
    section {
        padding: 30px 25px;
        margin: 25px 10px;
    }
    
    h2 {
        font-size: 24px;
    }
    
    nav {
        padding: 12px 10px;
    }
    
    nav a {
        display: inline-block;
        font-size: 13px;
        margin: 4px;
        padding: 6px 12px;
    }
    
    .simulator {
        padding: 25px 20px;
    }
    
    .resultado {
        font-size: 34px;
    }
}

@media(max-width: 480px) {
    .cards {
        grid-template-columns: 1fr;
    }
    
    td, th {
        padding: 12px 14px;
        font-size: 14px;
    }
}
</style>
</head>

<body>

<header>
    <h1><span class="emoji">☀️</span> Sensores de Luz e Radiação Solar</h1>
    <p>Entendendo como a luz solar pode ser medida e aproveitada de forma inteligente.</p>
    <div class="header-decoration"></div>
</header>

<nav>
    <a href="#introducao">Introdução</a>
    <a href="#sensores">Sensores</a>
    <a href="#intensidade">Intensidade</a>
    <a href="#coletor">Coletor Solar</a>
    <a href="#limitacoes">Limitações</a>
</nav>

<div class="container">

<section id="introducao" class="reveal">
    <h2>☀️ O que é radiação solar?</h2>

    <p>
        A radiação solar é a energia emitida pelo Sol na forma de
        ondas eletromagnéticas. Ela chega até a Terra e pode ser
        aproveitada para produzir eletricidade e calor.
    </p>

    <p>
        Os sensores de luz são dispositivos que detectam a presença
        e a intensidade da iluminação. Eles ajudam a acompanhar
        a quantidade de luz solar recebida em diferentes locais.
    </p>

    <div class="highlight">
        <strong>Você sabia?</strong>
        A posição do Sol muda durante o dia. Por isso, a intensidade
        da luz recebida por um painel solar também pode variar.
    </div>
</section>

<section id="sensores" class="reveal">
    <h2>🔬 Como funcionam os sensores?</h2>

    <div class="cards">

        <div class="card">
            <div class="icon">💡</div>
            <h3>LDR</h3>
            <p>
                O LDR é um resistor dependente de luz.
                Quando recebe mais iluminação, sua resistência elétrica
                geralmente diminui. Quando recebe menos luz,
                sua resistência aumenta.
            </p>
        </div>

        <div class="card">
            <div class="icon">📡</div>
            <h3>Fotodiodo</h3>
            <p>
                O fotodiodo transforma a luz recebida em uma corrente
                elétrica. Quanto maior a quantidade de luz,
                maior tende a ser a corrente produzida,
                dentro da faixa de funcionamento do sensor.
            </p>
        </div>

    </div>

    <div class="highlight">
        <strong>Diferença principal:</strong>
        O LDR varia sua resistência elétrica, enquanto o fotodiodo
        produz uma corrente elétrica relacionada à luz recebida.
    </div>
</section>

<section id="intensidade" class="reveal">
    <h2>📊 Como comparar a intensidade luminosa?</h2>

    <p>
        Podemos colocar sensores em diferentes posições e observar
        a quantidade de luz que cada um recebe.
        Assim, conseguimos identificar os locais mais iluminados.
    </p>

    <div class="table-wrapper">
    <table>
        <tr>
            <th>Posição</th>
            <th>Iluminação</th>
            <th>Intensidade relativa</th>
        </tr>
        <tr>
            <td>Sol direto</td>
            <td>Alta</td>
            <td>100%</td>
        </tr>
        <tr>
            <td>Sombra parcial</td>
            <td>Média</td>
            <td>50%</td>
        </tr>
        <tr>
            <td>Ambiente fechado</td>
            <td>Baixa</td>
            <td>20%</td>
        </tr>
    </table>
    </div>

    <p style="margin-top:20px; font-style: italic; color: var(--muted);">
        Os valores são exemplos ilustrativos, não medições reais.
    </p>
</section>

<section id="coletor" class="reveal">
    <h2>🌞 Simulador de intensidade solar</h2>

    <p>
        Movimente a barra para simular diferentes níveis de
        iluminação recebidos por um coletor solar.
    </p>

    <div class="simulator">

        <label for="luz">
            Intensidade da iluminação:
        </label>

        <input type="range" id="luz"
        min="0" max="100" value="50">

        <div class="resultado" id="valor">
            50%
        </div>

        <div class="bar">
            <div class="fill" id="barra"></div>
        </div>

        <h3 id="situacao">🌤️ Iluminação moderada</h3>

        <p id="descricao">
            O coletor recebe uma quantidade intermediária de luz.
        </p>

    </div>

    <h3>Qual é o melhor posicionamento?</h3>

    <p>
        O melhor posicionamento para um coletor solar é aquele
        que permite receber a maior quantidade possível de
        radiação solar durante o período de utilização.
    </p>

    <p>
        Para descobrir esse local, podemos comparar medições
        feitas em diferentes ângulos e posições, durante
        vários horários do dia.
    </p>

    <div class="highlight">
        <strong>Conclusão:</strong>
        O posicionamento com maior incidência de radiação solar
        tende a favorecer o aproveitamento da energia solar.
    </div>
</section>

<section id="limitacoes" class="reveal">
    <h2>⚠️ Quais são as limitações dos sensores?</h2>

    <div class="cards">

        <div class="card">
            <div class="icon">🌥️</div>
            <h3>Condições climáticas</h3>
            <p>
                Nuvens, chuva e neblina alteram a quantidade
                de radiação solar recebida.
            </p>
        </div>

        <div class="card">
            <div class="icon">📏</div>
            <h3>Precisão</h3>
            <p>
                Sensores simples podem não fornecer medições
                muito precisas e precisam de calibração.
            </p>
        </div>

        <div class="card">
            <div class="icon">🌈</div>
            <h3>Tipo de luz</h3>
            <p>
                Alguns sensores respondem melhor a determinadas
                faixas do espectro eletromagnético.
            </p>
        </div>

        <div class="card">
            <div class="icon">🌡️</div>
            <h3>Temperatura</h3>
            <p>
                A temperatura pode alterar o funcionamento
                e as medições de alguns sensores.
            </p>
        </div>

    </div>

    <div class="highlight">
        <strong>Importante:</strong>
        Medir a intensidade da luz não é o mesmo que medir
        diretamente a energia solar recebida.
        Para medir a irradiância solar com precisão, é indicado
        utilizar instrumentos apropriados, como um piranômetro.
    </div>
</section>

<section class="reveal">
    <h2>📚 Conclusão</h2>

    <p>
        Os sensores LDR e fotodiodos permitem acompanhar a
        iluminação e comparar diferentes posições em relação
        à incidência solar. Com essas informações, podemos
        investigar qual é o melhor posicionamento para um
        coletor solar.
    </p>

    <p>
        Entretanto, é importante considerar as limitações
        dos sensores e lembrar que a medição da luz não
        representa necessariamente toda a energia solar
        disponível.
    </p>

    <div class="highlight">
        <strong>Objetivo alcançado:</strong>
        Com o uso de sensores, podemos compreender melhor
        a radiação solar e como aproveitá-la de maneira eficiente.
    </div>
</section>

</div>

<footer>
    <div class="footer-decoration">
        <span>☀️</span>
        <span>🔬</span>
        <span>📊</span>
        <span>🌞</span>
    </div>
    <h3>Projeto de Ciências e Tecnologia</h3>
    <p>Sensores de Luz e Acompanhamento da Radiação Solar</p>
    <p style="margin-top: 15px; font-size: 12px; opacity: 0.7;">© 2026 — Estudo interativo sobre energia solar</p>
</footer>

<script>
const luz = document.getElementById("luz");
const valor = document.getElementById("valor");
const barra = document.getElementById("barra");
const situacao = document.getElementById("situacao");
const descricao = document.getElementById("descricao");

function atualizarSimulador() {
    let intensidade = Number(luz.value);

    valor.textContent = intensidade + "%";
    barra.style.width = intensidade + "%";

    if (intensidade >= 70) {
        situacao.textContent = "☀️ Iluminação alta";
        descricao.textContent =
        "O coletor recebe bastante luz solar e apresenta maior potencial de aproveitamento.";
    }
    else if (intensidade >= 30) {
        situacao.textContent = "🌤️ Iluminação moderada";
        descricao.textContent =
        "O coletor recebe uma quantidade intermediária de luz.";
    }
    else {
        situacao.textContent = "☁️ Iluminação baixa";
        descricao.textContent =
        "O coletor recebe pouca luz e pode apresentar menor aproveitamento solar.";
    }
}

luz.addEventListener("input", atualizarSimulador);
atualizarSimulador();

// Scroll reveal animation
const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
};

const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('active');
        }
    });
}, observerOptions);

document.querySelectorAll('.reveal').forEach(el => {
    observer.observe(el);
});

// Smooth scroll for nav links
document.querySelectorAll('nav a').forEach(link => {
    link.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    });
});
</script>

</body>
</html>
